---
permalink: feed.xml
eleventyExcludeFromCollections: true
metadata:
  title: killeik grimoire
  subtitle: personal magical book on the web
  language: en
  base: https://killeik.net/
  author:
    name: killeik
    email: qadol4zpb@mozmail.com
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ metadata.language }}">
  <title>{{ metadata.title }}</title>
  <subtitle>{{ metadata.description }}</subtitle>
  <link href="{{ permalink | htmlBaseUrl: metadata.base }}" rel="self" />
  <link href="{{ metadata.base | addPathPrefixToFullUrl }}" />
  <updated>{{ collections.posts | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  <id>{{ metadata.base | addPathPrefixToFullUrl }}</id>
  <author>
    <name>{{ metadata.author.name }}</name>
  </author>
  {%- for post in collections.all | reverse -%}
  {% assign absolutePostUrl = post.url | htmlBaseUrl: metadata.base %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ absolutePostUrl }}" />
    <updated>{{ post.date | dateToRfc3339 }}</updated>
    <id>{{ absolutePostUrl }}</id>
    <content type="html">{{ post.content | renderTransforms:post.data.page, metadata.base |escape}}</content>
  </entry>
  {%- endfor %}
</feed>
