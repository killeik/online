---
layout: base.liquid
---
<article class=card>
  <a class=primary href="{{link}}">
    <h3>{{title}}</h3>
  </a>
  {{ content }}
  {% sidebyside %}
  {%- for tag in tags -%}
  {% if tag != 'webindex' %}
  <mark>
    <a href='/web/{{tag}}'> #{{tag}} </a>
  </mark>
  {% endif %}
  {%- endfor -%}
  <mark>
    <a href="/web/"> &lt;-+- </a>
  </mark>
  {% endsidebyside %}
</article>
